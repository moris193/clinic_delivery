<?xml version="1.0"?>
<!--
  院内搬送ロボット delivery_bot（Gazebo Fortress用）
  - 差動二輪（車輪半径 0.033 m、車輪間 0.19 m：参考資料と同じ寸法）
  - 前後に摩擦ゼロのキャスター
  - 上面に LiDAR（360本、10Hz）
  - DiffDrive が /cmd_vel を受けて走り、/odom と /tf(odom→base_link) を出す
-->
<sdf version="1.8">
  <model name="delivery_bot">

    <!-- ===== 本体 ===== -->
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0045</ixx><iyy>0.00826</iyy><izz>0.01186</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.25 0.18 0.06</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.25 0.18 0.06</size></box></geometry>
        <material>
          <ambient>0.2 0.4 0.8 1</ambient>
          <diffuse>0.2 0.4 0.8 1</diffuse>
        </material>
      </visual>

      <!-- 荷台（検体・書類ボックス。見た目のみ） -->
      <visual name="cargo_visual">
        <pose>-0.05 0 0.06 0 0 0</pose>
        <geometry><box><size>0.12 0.14 0.06</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>

      <!-- LiDAR 本体の見た目 -->
      <visual name="lidar_visual">
        <pose>0.08 0 0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- LiDAR センサー（base_link から x=0.08, z=0.05 の位置） -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.08 0 0.05 0 0 0</pose>
        <topic>scan</topic>
        <ignition_frame_id>lidar_link</ignition_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- ===== 左車輪 ===== -->
    <link name="wheel_left_link">
      <pose>0 0.095 0.033 -1.5707 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>2.99e-05</ixx><iyy>2.99e-05</iyy><izz>5.4e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
      </collision>
      <visual name="wheel_left_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- ===== 右車輪 ===== -->
    <link name="wheel_right_link">
      <pose>0 -0.095 0.033 -1.5707 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>2.99e-05</ixx><iyy>2.99e-05</iyy><izz>5.4e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
      </collision>
      <visual name="wheel_right_visual">
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- ===== キャスター（前・後）：摩擦ゼロの球を固定 ===== -->
    <link name="caster_front_link">
      <pose>0.10 0 0.015 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-06</ixx><iyy>1e-06</iyy><izz>1e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="caster_front_collision">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_front_visual">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
    </link>
    <joint name="caster_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_front_link</child>
    </joint>

    <link name="caster_back_link">
      <pose>-0.10 0 0.015 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-06</ixx><iyy>1e-06</iyy><izz>1e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="caster_back_collision">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_back_visual">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>
    </link>
    <joint name="caster_back_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_back_link</child>
    </joint>

    <!-- ===== 差動二輪プラグイン ===== -->
    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.19</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
